{
  "name": "@expressive/jsx",
  "version": "0.1.0",
  "description": "Base JSX host for Expressive: renderer, style engine and JSX runtime.",
  "license": "MIT",
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@expressive.dev",
    "url": "https://github.com/gabeklein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive.git"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "coverage": "vitest run --coverage",
    "test": "bun run typecheck && bun run coverage"
  },
  "peerDependencies": {
    "@expressive/mvc": "^0.98.0"
  },
  "devDependencies": {
    "@expressive/mvc": "workspace:^",
    "@types/node": "^25.2.0",
    "tsdown": "^0.20.1"
  }
}
