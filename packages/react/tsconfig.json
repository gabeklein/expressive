{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "types": ["react", "node"],
    "paths": {
      "@expressive/react/jsx-runtime": ["./src/jsx-runtime"],
      "@expressive/react/jsx-dev-runtime": ["./src/jsx-dev-runtime"],
      "@expressive/mvc/*": ["../mvc/src/*"],
      "@expressive/jsx/*": ["../jsx/src/*"],
      "@expressive/*": ["../*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "vitest.config.ts", "vitest.compat.config.ts", "src/compat", "test.compat.setup.ts"]
}
