{
  "name": "@expressive/env",
  "version": "0.1.0",
  "description": "Typed .env for Expressive: read keys as env.NAME on the server and, behind a prefix, in the client.",
  "keywords": [
    "expressive",
    "env",
    "dotenv",
    "vite"
  ],
  "license": "MIT",
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@expressive.dev",
    "url": "https://github.com/gabeklein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive.git"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "expressive": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    }
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "coverage": "vitest run --coverage",
    "test": "bun run typecheck && bun run coverage"
  },
  "dependencies": {
    "@expressive/cli": "^0.2.3"
  },
  "peerDependencies": {
    "@expressive/mvc": "^0.97.1",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expressive/mvc": "workspace:*",
    "@types/node": "^25.2.0",
    "tsdown": "^0.20.1",
    "vite": "^8.0.0"
  }
}
